// components/sections/projects.tsx
import React from "react";
import Image from "next/image";
import {
  Dialog,
  DialogTrigger,
  DialogContent,
  DialogHeader,
  DialogFooter,
  DialogTitle,
  DialogDescription,
  DialogClose,
  DialogOverlay,
  DialogPortal
} from "@/components/ui/dialog";

const projectImageMap: Record<string, string> = {
  "Payments Platform": "/images/projects/payments-platform.png",
  "Care Portal": "/images/projects/care-portal.png",
  "Analytics SaaS": "/images/projects/analytics-saas.png",
};

function getProjectImg(title: string) {
  return projectImageMap[title] || "/images/projects/analytics-saas.png";
}

const ProjectsSection: React.FC = () => {
  const projects = [
    { title: "Payments Platform", imageAlt: "Payments Platform Image" },
    { title: "Care Portal", imageAlt: "Care Portal Image" },
    { title: "Analytics SaaS", imageAlt: "Analytics SaaS Image" },
  ];

  const [active, setActive] = React.useState(null);

  return (
    <div>
      {projects.map((p) => (
        <div key={p.title} className="group">
          <Image
            src={getProjectImg(p.title) || "/placeholder.svg"}
            alt={p.imageAlt}
            fill
            className="object-cover transition-transform duration-300 group-hover:scale-[1.03]"
          />
          <Dialog open={active === p} onOpenChange={(open) => (open ? setActive(p) : setActive(null))}>
            <DialogContent>
              <Image
                src={getProjectImg(active.title) || "/placeholder.svg"}
                alt={active.imageAlt}
                fill
                className="object-cover"
              />
            </DialogContent>
          </Dialog>
        </div>
      ))}
    </div>
  );
};

export default ProjectsSection;

