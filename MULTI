/// components/custom-cursor.tsx
import React from "react";

interface CustomCursorProps {
  isInteractive: boolean;
}

const CustomCursor: React.FC<CustomCursorProps> = ({ isInteractive }) => {
  const color = getContrastColor(isInteractive);
  const scale = isInteractive ? 1.35 : 1;

  return (
    <div
      style={{
        width: 18,
        height: 18,
        backgroundColor: color,
        opacity: 0.6,
        transform: `scale(${scale})`,
        boxShadow: "0 0 16px color-mix(in oklab, var(--primary), transparent 70%)",
        border: "1px solid rgba(255,255,255,0.35)",
        borderRadius: 9999,
      }}
      className="mix-blend-difference transition-[transform,background-color,opacity] duration-150 ease-out"
    />
  );
};

function getContrastColor(isInteractive: boolean) {
  return isInteractive
    ? "color-mix(in oklab, var(--fg), white 25%)"
    : "color-mix(in oklab, var(--primary), white 35%)";
}

export default CustomCursor;

